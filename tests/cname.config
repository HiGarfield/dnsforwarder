# Configuration used by tests/run_cname_redirect.py.
#   * UDPGroup points at the local "good upstream" started by the script.
#   * AppendHosts sets up a Type-2 (CName) redirect:
#       queries to *.cname.test are answered by resolving cname-target.test.
LogOn false
UDPLocal 127.0.0.1:15353
UDPGroup 127.0.0.1:15354 * off
AppendHosts cname-target.test *.cname.test
UseCache false
MemoryCache true
CacheSize 1048576
DomainStatistic false
ModulesUpdateInterval -1
Hosts
DisabledList
DisabledDomain
IPSubstituting
BlockIP
