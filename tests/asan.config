# Minimal configuration used by the regression/fuzz scripts.
# Listens on loopback only, forwards nowhere (unreachable upstream) so that
# every code path is exercised without needing real network access.
LogOn false
UDPLocal 127.0.0.1:15353
TCPLocal 127.0.0.1:15363
UDPGroup 127.0.0.1:15354 * off
UseCache true
MemoryCache true
CacheSize 1048576
CacheParallel true
OverrideTTL 600
MultipleTTL 1
DomainStatistic false
ModulesUpdateInterval -1
AppendHosts 127.0.0.1 localhost.test
Hosts
DisabledList
DisabledDomain
IPSubstituting
BlockIP
